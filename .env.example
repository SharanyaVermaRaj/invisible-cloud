# Copy to .env for local development (never commit .env).
# Leave DATABASE_URL unset to use a local SQLite file.
# DATABASE_URL=postgresql://user:password@localhost:5432/invisible_cloud
SECRET_KEY=change-me-to-a-long-random-string
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
COOKIE_SECURE=false
# Spending guardrails for the public demo
AI_LIMIT_PER_WORKSPACE_PER_HOUR=40
AI_LIMIT_PER_DAY=1000
WORKSPACE_TTL_DAYS=7
